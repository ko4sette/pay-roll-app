rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeUser() {
      return signedIn() && myProfile().isActive == true;
    }

    function isAdmin() {
      return activeUser() && myProfile().get('mustChangePassword', false) == false && myProfile().role == 'admin';
    }

    function isFinance() {
      return activeUser() && myProfile().get('mustChangePassword', false) == false && myProfile().role == 'finance';
    }

    function isStaff() {
      return activeUser() && myProfile().get('mustChangePassword', false) == false && myProfile().role == 'staff';
    }

    match /users/{userId} {
      allow get: if activeUser() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      // Admin app creates staff profiles only; clients can never assign elevated roles.
      allow create: if isAdmin()
        && request.resource.data.role == 'staff'
        && request.resource.data.isActive == true
        && request.resource.data.employeeId is string
        && existsAfter(/databases/$(database)/documents/employees/$(request.resource.data.employeeId))
        && getAfter(/databases/$(database)/documents/employees/$(request.resource.data.employeeId)).data.emailLowercase == request.resource.data.emailLowercase;
      // Admin can deactivate/reactivate staff. Staff can only clear their own first-login flag.
      allow update: if (
          isAdmin()
          && resource.data.role == 'staff'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isActive', 'updatedAt'])
        ) || (
          request.auth.uid == userId
          && activeUser()
          && resource.data.role == 'staff'
          && resource.data.get('mustChangePassword', false) == true
          && request.resource.data.get('mustChangePassword', true) == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword', 'updatedAt'])
        );
      allow delete: if false;
    }

    match /employees/{employeeId} {
      allow read: if activeUser() && (
        isAdmin()
        || isFinance()
        || (isStaff() && myProfile().employeeId == employeeId)
      );
      allow create, update, delete: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read: if activeUser() && (
        isAdmin()
        || (isStaff() && resource.data.employeeId == myProfile().employeeId)
      );
      allow create: if isAdmin() || (
        isStaff() && request.resource.data.employeeId == myProfile().employeeId
      );
      allow update: if isAdmin() || (
        isStaff()
        && resource.data.employeeId == myProfile().employeeId
        && request.resource.data.employeeId == resource.data.employeeId
      );
      allow delete: if isAdmin();
    }

    // Shared payroll: Admin prepares records, Finance can record a pending pay,
    // and each employee can read only their own payslips.
    match /payrollRecords/{recordId} {
      allow read: if activeUser() && (
        isAdmin()
        || isFinance()
        || (isStaff() && resource.data.employeeId == myProfile().employeeId)
      );
      allow create: if isAdmin()
        && request.resource.data.employeeId is string
        && request.resource.data.status == 'Pending'
        && request.resource.data.netPay is number
        && request.resource.data.periodStart is string
        && request.resource.data.periodEnd is string
        && exists(/databases/$(database)/documents/employees/$(request.resource.data.employeeId));
      allow update: if isAdmin() || (
        isFinance()
        && resource.data.status == 'Pending'
        && request.resource.data.status == 'Paid'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'paidAt', 'updatedAt', 'paymentMethod'])
        && request.resource.data.paidAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.paymentMethod in ['Cash', 'Bank transfer', 'E-wallet']
      );
      allow delete: if isAdmin();
    }

    // Public lookup returns only a non-deliverable Firebase login alias, never an email.
    // Allow direct document reads so employees can map email or ID to their Auth account;
    // disallow listing and all public writes.
    match /loginLookup/{lookupId} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Payroll, payments, and requests stay device-local in this phase.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
